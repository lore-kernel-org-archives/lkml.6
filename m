   244	
   245		pci_read_config_dword(pdev, pos + PCI_ERR_UNCOR_MASK, &reg32);
   246		if (enable)
   247			reg32 &= ~PCI_ERR_UNC_SURPDN;
   248		else
   249			reg32 |= PCI_ERR_UNC_SURPDN;
   250		pci_write_config_dword(pdev, pos + PCI_ERR_UNCOR_MASK, reg32);
