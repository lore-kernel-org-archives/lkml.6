> [    1.281396]  dump_stack+0xa8/0xcc
> [    1.284717]  of_node_release+0xb0/0xc8
> [    1.288474]  kobject_put+0x74/0xf0
> [    1.291879]  of_node_put+0x14/0x28
> [    1.295286]  __of_get_next_child+0x44/0x70
