Subject: [PATCH] random: Debug fast init

---
 drivers/char/random.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/char/random.c b/drivers/char/random.c
index c75b6cdf0053..a28d0a23625e 100644
--- a/drivers/char/random.c
+++ b/drivers/char/random.c
@@ -855,6 +855,8 @@ static int crng_fast_load(const char *cp, size_t len)=

 	unsigned long flags;
 	char *p;
=20
+	pr_notice("random: 1\n");
+
 	if (!spin_trylock_irqsave(&primary_crng.lock, flags))
 		return 0;
 	if (crng_init !=3D 0) {
@@ -862,11 +864,14 @@ static int crng_fast_load(const char *cp, size_t le=
n)
 		return 0;
 	}
 	p =3D (unsigned char *) &primary_crng.state[4];
+	pr_notice("random: 2\n");
 	while (len > 0 && crng_init_cnt < CRNG_INIT_CNT_THRESH) {
 		p[crng_init_cnt % CHACHA20_KEY_SIZE] ^=3D *cp;
 		cp++; crng_init_cnt++; len--;
 	}
+	pr_notice("random: 3\n");
 	spin_unlock_irqrestore(&primary_crng.lock, flags);
+	pr_notice("random: 4\n");
 	if (crng_init_cnt >=3D CRNG_INIT_CNT_THRESH) {
 		invalidate_batched_entropy();
 		crng_init =3D 1;
--=20
