  2335		}
  2336	
  2337		if (reprogram) {
  2338			ctx_sched_out(ctx, cpuctx, EVENT_TIME);
  2339			add_event_to_ctx(event, ctx);
  2340			ctx_resched(cpuctx, task_ctx, get_event_type(event));
  2341		} else {
  2342			add_event_to_ctx(event, ctx);
  2343		}
  2344	
