Executables that are generated by Clang don't have a .shstrtab
section, and store section names in .strtab instead. We can store
section names generated by orc there in this case.

Signed-off-by: Simon Ser <contact@emersion.fr>
---
 tools/objtool/elf.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tools/objtool/elf.c b/tools/objtool/elf.c
index 4e60e105583..6b9705d8b55 100644
--- a/tools/objtool/elf.c
+++ b/tools/objtool/elf.c
@@ -507,7 +507,10 @@ struct section *elf_create_section(struct elf *elf, co=
nst char *name,
 =09/* Add section name to .shstrtab */
 =09shstrtab =3D find_section_by_name(elf, ".shstrtab");
 =09if (!shstrtab) {
-=09=09WARN("can't find .shstrtab section");
+=09=09shstrtab =3D find_section_by_name(elf, ".strtab");
+=09}
+=09if (!shstrtab) {
+=09=09WARN("can't find .shstrtab or .strtab section");
 =09=09return NULL;
 =09}
=20
--=20
